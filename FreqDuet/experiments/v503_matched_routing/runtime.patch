+def station_band(state, band: str) -> tuple[float, float]:
+    current = float(getattr(state, band))
+    return current, current - float(getattr(state, "prev_" + band))
+
+
+def band_for_head(band_mode: str, *, upper: bool) -> str:
+    if band_mode not in ("aligned", "swapped"):
+        raise ValueError(f"Unknown V503 arm: {band_mode}")
+    return "low" if (band_mode == "aligned") == upper else "high"
+
+
+def upper_band(env: env_bus, which: str, daily_pax_prior: float) -> list[float]:
+    tracker = env.frequency_tracker
+    scale = max(0.5 * daily_pax_prior / 783.0, 0.2)
+    features = []
+    for direction in (True, False):
+        vals = [station_band(tracker._get_local_state((int(st.station_id), direction)), which)
+                for st in env.stations
+                if st.station_type != 0 and st.od is not None and bool(st.direction) == direction]
+        rate, slope = np.asarray(vals, dtype=np.float64).T
+        features.extend(np.clip([rate.sum() / scale, np.sqrt(np.mean(rate**2)) * len(rate) / scale,
+                                 rate.std() * len(rate) / scale, slope.sum() * 5 / scale],
+                                -3.5, 3.5))
+    return features
+
+
+def lower_band(tracker, station: int, downstream: list[int], direction: bool, which: str) -> list[float]:
+    here, change = station_band(tracker._get_local_state((station, direction)), which)
+    nearby = [station_band(tracker._get_local_state((sid, direction)), which) for sid in downstream]
+    near, near_change = np.mean(nearby, axis=0) if nearby else (0.0, 0.0)
+    return np.clip(np.asarray([here, near, 5 * change, 5 * near_change]) / 3.0, -3.5, 3.5).tolist()
+
+
